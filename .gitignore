# Dependencies (restored with `pnpm install`)
node_modules/

# Build output — shipped in the tarball/npm package, but regenerated by
# `node scripts/build.mjs`, so the repository keeps the source of truth only.
lib/

# Release artifacts (`node scripts/pack-tarball.mjs`)
release/

# The real registry entry lives in the registry PR; the local copies are
# generated from a repository name and are gitignored to avoid drift.
registry-pr/

# The vendored real-vitest harness used for cross-checking test results. It is
# ~36 MB, excluded from the published package, and only needed locally.
tests/.suite/
# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
