# Dependencies (restored with `pnpm install`)
node_modules/

# NOTE: `lib/` is deliberately NOT ignored.
#
# DSH loads a plugin from the files the bundle patch points at, and GitHub installs
# (`dsh plugin --profile web add github:ZhaoZeW/dsh-rollback`) do not install
# devDependencies — so `scripts/build.mjs` cannot run in the consumer's tree
# (it needs rolldown). Committing the built bundles is what makes a GitHub install
# actually work. Regenerate with `node scripts/build.mjs`; the npm package ships the
# same files, and `scripts/verify-artifacts.mjs` is the guard against them drifting
# from `src/`.

# Release artifacts (`node scripts/pack-tarball.mjs`) — rebuilt per release.
release/

# The real registry entry lives in the registry PR; the local copies are
# generated from a repository name and are gitignored to avoid drift.
registry-pr/

# The vendored real-vitest harness used for cross-checking test results. It is
# ~36 MB, excluded from the published package, and only needed locally.
tests/.suite/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

